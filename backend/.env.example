# Local default. Tests and the UI run with no Azure credentials.
USE_MOCK_AZURE=true

# Optional pause between job stages so the UI can show progress. Milliseconds.
AUDIT_STAGE_DELAY_MS=0

DATA_DIR=
FRONTEND_ORIGINS=http://127.0.0.1:43123,http://localhost:43123
# Serve the built React app from FastAPI (Azure App Service single-site deploy).
SERVE_FRONTEND=false
STATIC_DIR=
MAX_UPLOAD_BYTES=20971520
LOG_LEVEL=INFO

# --- Azure AI live mode (USE_MOCK_AZURE=false) ---
# Prefer managed identity on App Service; leave keys empty when MI is enabled.
AZURE_USE_MANAGED_IDENTITY=true

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Connection string OR account URL (MI). Account URL example:
# https://<account>.blob.core.windows.net
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=incident-audits

AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE=incident-audit
AZURE_COSMOS_CONTAINER=audits

# Optional. When empty, criteria load from audit_criteria.json.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=audit-criteria
